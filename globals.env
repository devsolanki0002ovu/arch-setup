#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# globals.env — God-Tier LTSC Provisioner Configuration
# ─────────────────────────────────────────────────────────────────────────────
# This file is sourced by every module. It contains ONLY variable assignments.
# No functions, no logic, no side effects.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity (set by 01-preflight.sh if interactive) ─────────────────────────
GTLTSC_HOSTNAME="${GTLTSC_HOSTNAME:-archltsc}"
GTLTSC_USERNAME="${GTLTSC_USERNAME:-}"
GTLTSC_USER_DISPLAY="${GTLTSC_USER_DISPLAY:-}"
GTLTSC_USER_PASSWORD="${GTLTSC_USER_PASSWORD:-}"
GTLTSC_ROOT_PASSWORD="${GTLTSC_ROOT_PASSWORD:-}"

# ── Localization ─────────────────────────────────────────────────────────────
GTLTSC_LOCALE="${GTLTSC_LOCALE:-en_US.UTF-8}"
GTLTSC_KEYMAP="${GTLTSC_KEYMAP:-us}"
GTLTSC_TIMEZONE="${GTLTSC_TIMEZONE:-Asia/Kolkata}"

# ── Disk Layout ──────────────────────────────────────────────────────────────
GTLTSC_TARGET_DISK="${GTLTSC_TARGET_DISK:-}"          # e.g. /dev/sda — set interactively
GTLTSC_EFI_SIZE="${GTLTSC_EFI_SIZE:-512M}"
GTLTSC_EFI_SIZE_SECTORS="${GTLTSC_EFI_SIZE_SECTORS:-+512M}"
GTLTSC_MOUNT_ROOT="${GTLTSC_MOUNT_ROOT:-/mnt}"
# Partition paths are discovered dynamically — NEVER hardcoded
GTLTSC_EFI_PART=""
GTLTSC_ROOT_PART=""

# ── Logging ──────────────────────────────────────────────────────────────────
GTLTSC_LOG_DIR="${GTLTSC_LOG_DIR:-/tmp/god-tier-ltsc}"
GTLTSC_LOG_FILE="${GTLTSC_LOG_DIR}/install.log"
GTLTSC_CURRENT_STAGE="init"

# ── Retry Configuration ─────────────────────────────────────────────────────
GTLTSC_RETRY_COUNT="${GTLTSC_RETRY_COUNT:-3}"
GTLTSC_RETRY_DELAY="${GTLTSC_RETRY_DELAY:-5}"

# ── Partition Readiness ─────────────────────────────────────────────────────
GTLTSC_PARTITION_WAIT_TIMEOUT="${GTLTSC_PARTITION_WAIT_TIMEOUT:-30}"
GTLTSC_PARTITION_POLL_INTERVAL="${GTLTSC_PARTITION_POLL_INTERVAL:-1}"

# ── Performance Tuning ──────────────────────────────────────────────────────
GTLTSC_SWAPPINESS=100
GTLTSC_DIRTY_BG_RATIO=5
GTLTSC_DIRTY_RATIO=10
GTLTSC_VFS_CACHE_PRESSURE=50
GTLTSC_HDD_READ_AHEAD_KB=128
GTLTSC_ZRAM_SIZE_PERCENT=100
GTLTSC_ZRAM_ALGORITHM="zstd"
GTLTSC_JOURNAL_MAX_USE="50M"

# ── Boot ─────────────────────────────────────────────────────────────────────
GTLTSC_GRUB_TIMEOUT=2
GTLTSC_KERNEL="linux-lts"
GTLTSC_MKINITCPIO_HOOKS="base udev plymouth autodetect modconf kms keyboard keymap consolefont block filesystems fsck"

# ── Theming ──────────────────────────────────────────────────────────────────
GTLTSC_LXQT_THEME="Leech"
GTLTSC_LXQT_THEME_FALLBACK="ambiance"
GTLTSC_GTK_THEME="Materia-dark"
GTLTSC_ICON_THEME="Papirus-Dark"
GTLTSC_CURSOR_THEME="Adwaita"
GTLTSC_CURSOR_SIZE=24
GTLTSC_FONT="Noto Sans"
GTLTSC_FONT_SIZE=10
GTLTSC_DESKTOP_BG_COLOR="#111111"

# ── Package Lists ───────────────────────────────────────────────────────────
# Base system — essential for boot and operation
GTLTSC_PKG_BASE=(
    base
    base-devel
    linux-lts
    linux-lts-headers
    linux-firmware
    intel-ucode
    grub
    efibootmgr
    networkmanager
    sudo
    bash
    nano
    vim
    man-db
    man-pages
    texinfo
)

# Boot & Performance
GTLTSC_PKG_BOOT=(
    plymouth
    earlyoom
    zram-generator
)

# Xorg & GPU
GTLTSC_PKG_XORG=(
    xorg-server
    xorg-xinit
    xorg-xrandr
    xorg-xset
    xorg-xsetroot
    xf86-video-nouveau
    mesa
    mesa-utils
)

# LXQt Desktop
GTLTSC_PKG_LXQT=(
    lxqt-about
    lxqt-admin
    lxqt-config
    lxqt-globalkeys
    lxqt-notificationd
    lxqt-openssh-askpass
    lxqt-panel
    lxqt-policykit
    lxqt-powermanagement
    lxqt-qtplugin
    lxqt-runner
    lxqt-session
    lxqt-sudo
    lxqt-themes
    pcmanfm-qt
    openbox
    obconf
    sddm
    xdg-utils
    xdg-user-dirs
)

# Audio (PipeWire)
GTLTSC_PKG_AUDIO=(
    pipewire
    pipewire-alsa
    pipewire-pulse
    pipewire-jack
    wireplumber
)

# Theming & Appearance
GTLTSC_PKG_THEME=(
    materia-gtk-theme
    papirus-icon-theme
    breeze-icons
    qt6ct
    noto-fonts
    noto-fonts-cjk
    noto-fonts-emoji
    ttf-dejavu
)

# GUI Applications
GTLTSC_PKG_GUI_APPS=(
    firefox
    featherpad
    lximage-qt
    qpdfview
    pavucontrol-qt
    lxterminal
    archlinux-wallpaper
)

# Utilities & Tools
GTLTSC_PKG_UTILS=(
    htop
    fastfetch
    p7zip
    unzip
    unrar
    wget
    curl
    git
    usbutils
    pciutils
    dosfstools
    ntfs-3g
    gptfdisk
    xmlstarlet
)

# Mobile device support
GTLTSC_PKG_MOBILE=(
    gvfs
    gvfs-mtp
    gvfs-gphoto2
    android-udev
    libimobiledevice
    ifuse
    usbmuxd
)

# ── Aggregate Package List ──────────────────────────────────────────────────
GTLTSC_ALL_PACKAGES=(
    "${GTLTSC_PKG_BASE[@]}"
    "${GTLTSC_PKG_BOOT[@]}"
    "${GTLTSC_PKG_XORG[@]}"
    "${GTLTSC_PKG_LXQT[@]}"
    "${GTLTSC_PKG_AUDIO[@]}"
    "${GTLTSC_PKG_THEME[@]}"
    "${GTLTSC_PKG_GUI_APPS[@]}"
    "${GTLTSC_PKG_UTILS[@]}"
    "${GTLTSC_PKG_MOBILE[@]}"
)

# ── Services to Enable (system-level) ───────────────────────────────────────
GTLTSC_SERVICES_SYSTEM=(
    NetworkManager
    sddm
    earlyoom
)

# ── Services to Enable (global user-level) ──────────────────────────────────
GTLTSC_SERVICES_USER_GLOBAL=(
    pipewire
    pipewire-pulse
    wireplumber
)

# ── Firefox Enterprise Policy Keys ──────────────────────────────────────────
# These are written to /etc/firefox/policies/policies.json
GTLTSC_FIREFOX_DISABLE_TELEMETRY=true
GTLTSC_FIREFOX_DISABLE_POCKET=true
GTLTSC_FIREFOX_DISABLE_STUDIES=true
GTLTSC_FIREFOX_DISABLE_DEFAULT_BROWSER_CHECK=true
GTLTSC_FIREFOX_HOMEPAGE="about:blank"

# ── Desktop Entry Renames ───────────────────────────────────────────────────
# Format: "original_filename.desktop:New Display Name"
# Only the Name= key (unlocalised) is changed; Name[xx]= and Comment= preserved
GTLTSC_DESKTOP_RENAMES=(
    "lxterminal.desktop:Terminal"
    "featherpad.desktop:Text Editor"
    "pcmanfm-qt.desktop:File Manager"
    "lximage-qt.desktop:Image Viewer"
    "qpdfview.desktop:PDF Viewer"
    "firefox.desktop:Web Browser"
    "pavucontrol-qt.desktop:Sound Settings"
)
